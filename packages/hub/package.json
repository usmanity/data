	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"cf": "^1.0.0-beta.14",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"hono": "^4.13.13",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	}
