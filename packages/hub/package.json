{
	"name": "hub",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "cf dev",
		"build": "cf build",
		"deploy": "cf deploy",
		"typecheck": "cf workers types && tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json",
